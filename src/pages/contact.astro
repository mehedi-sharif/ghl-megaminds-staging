---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import { BOOKING_URL, CONTACT_FORM_ID, steps, trust } from '../data/site';

const formSrc = CONTACT_FORM_ID && `https://api.leadconnectorhq.com/widget/form/${CONTACT_FORM_ID}`;
---
<Layout
  title="Contact | GHL Megaminds"
  description="Tell us about your HighLevel agency. Certified admins and software engineers for onboarding, support, and custom GHL development."
>
  <Header />
  <main id="main-content" class="relative overflow-hidden">
    <div class="pointer-events-none absolute -top-40 left-1/2 h-[520px] w-[1100px] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(252,192,0,0.08),transparent)]" aria-hidden="true"></div>

    <section class="relative mx-auto grid max-w-7xl gap-12 px-4 pt-14 pb-20 sm:px-6 lg:grid-cols-[1fr_1.1fr] lg:gap-16 lg:px-8 lg:pt-24 lg:pb-28">
      <!-- Intro -->
      <div class="flex flex-col gap-7">
        <Eyebrow class="self-start">Contact</Eyebrow>
        <h1 class="text-5xl leading-[1.02] tracking-[-0.03em] sm:text-6xl lg:text-[64px]">
          Let's talk about <span class="text-muted italic">your agency.</span>
        </h1>
        <p class="max-w-[520px] text-lg leading-relaxed text-muted">
          Tell us where you're stuck (onboarding, daily support, or a custom build) and we'll come back with a clear plan.
        </p>

        <div class="flex flex-col gap-4 border-t border-hair pt-7">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">What happens next</p>
          <ol class="flex flex-col gap-4">
            {steps.map((s) => (
              <li class="flex gap-4">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-hair bg-surface font-serif text-sm">{s.n}</span>
                <div>
                  <p class="font-semibold">{s.title}</p>
                  <p class="mt-0.5 text-[15px] leading-relaxed text-muted">{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <ul class="flex flex-col gap-2.5 text-[15px] text-muted">
          {trust.map((t) => (
            <li class="flex items-center gap-2.5">
              <svg class="size-4 text-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
              {t}
            </li>
          ))}
        </ul>
      </div>

      <!-- Form -->
      <div class="rounded-[28px] border border-hair bg-card p-2 shadow-[0_30px_80px_-40px_rgba(0,0,0,0.8)] sm:p-3">
        {formSrc ? (
          <div class="overflow-hidden rounded-[20px] bg-white">
            <iframe
              src={formSrc}
              id={`inline-${CONTACT_FORM_ID}`}
              data-layout="{'id':'INLINE'}"
              data-trigger-type="alwaysShow"
              data-activation-type="alwaysActivated"
              data-deactivation-type="neverDeactivate"
              data-form-id={CONTACT_FORM_ID}
              title="Contact GHL Megaminds"
              loading="lazy"
              class="block min-h-[640px] w-full border-0"
            ></iframe>
          </div>
        ) : (
          <div class="flex min-h-[480px] flex-col items-center justify-center gap-5 rounded-[20px] bg-surface px-6 py-16 text-center">
            <span class="flex size-14 items-center justify-center rounded-full bg-gold/10 text-gold ring-1 ring-gold/30">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
            </span>
            <h2 class="text-3xl tracking-tight">Book a 30-minute discovery call</h2>
            <p class="max-w-sm leading-relaxed text-muted">Pick a time that suits you and we'll walk through your agency's setup together.</p>
            <Button href={BOOKING_URL} size="lg" arrow>Choose a time</Button>
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer />

  {formSrc && <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>}
</Layout>

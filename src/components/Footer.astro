---
import Logo from './Logo.astro';
import { BOOKING_URL } from '../data/site';

const columns = [
  {
    title: 'Services',
    links: [
      { label: 'Client Onboarding & Setup', href: '#offers' },
      { label: 'Ongoing Tech Support', href: '#offers' },
      { label: 'Custom App & Wrapper Dev', href: '#offers' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'How it works', href: '#how-it-works' },
      { label: 'Projects', href: '#projects' },
      { label: 'Team', href: '#team' },
    ],
  },
];
const year = new Date().getFullYear();
---
<footer class="border-t border-hair bg-surface">
  <div class="mx-auto max-w-7xl px-4 pt-14 pb-8 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr] lg:gap-12">
      <div class="flex flex-col gap-4">
        <Logo />
        <p class="max-w-sm text-[15px] leading-relaxed text-muted">
          White-label HighLevel support by certified admins and software engineers.
        </p>
      </div>
      {columns.map((col) => (
        <nav aria-label={col.title} class="flex flex-col gap-3 text-[15px]">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">{col.title}</p>
          {col.links.map((l) => <a href={l.href} class="text-ink transition hover:text-gold">{l.label}</a>)}
        </nav>
      ))}
      <div class="flex flex-col gap-3 text-[15px]">
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">Get started</p>
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="font-semibold text-gold hover:underline">Book a discovery call →</a>
        <span class="text-muted">7-Day Money-Back Guarantee</span>
      </div>
    </div>
    <p class="mt-10 border-t border-hair pt-6 text-center text-[13px] text-muted">
      © {year} GHL Megaminds. All Rights Reserved.
    </p>
  </div>
</footer>

---
// Small pill label shown above section headings.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<span class:list={[
  'inline-block rounded-full border border-gold/30 bg-gold/8 px-3.5 py-1.5 text-xs font-semibold tracking-wide text-gold',
  className,
]}>
  <slot />
</span>
